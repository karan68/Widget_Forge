<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest for Widget Forge Provider
  
  This registers our widget types with the Windows 11 Widgets Board.
  Each widget definition corresponds to a prompt type in our backend.
  
  IMPORTANT: Replace the Publisher CN with your own certificate for production.
  For development/sideloading, use a self-signed certificate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <Identity
    Name="WidgetForge.Provider"
    Publisher="CN=WidgetForge"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Widget Forge</DisplayName>
    <PublisherDisplayName>Widget Forge Hackathon</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>AI-powered custom Windows 11 Widgets. Ask in natural language, get live widgets.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="WidgetForgeProvider"
      Executable="WidgetForgeProvider.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Widget Forge"
        Description="AI Widget Generator"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- COM Server registration for IWidgetProvider -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="WidgetForgeProvider.exe"
                          DisplayName="Widget Forge Provider">
              <com:Class Id="BFBE4C7A-3B4A-4F7C-9E4D-1A2B3C4D5E6F"
                        DisplayName="WidgetForgeProvider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Widget Provider registration -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets"
                            Id="WidgetForgeProvider"
                            DisplayName="Widget Forge"
                            Description="AI-generated widgets for your desktop"
                            PublicFolder="Assets">

            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\WidgetForge_Icon.png" />
                </ProviderIcons>
                <Activation>
                  <!-- CLSID must match com:Class Id above -->
                  <CreateInstance ClassId="BFBE4C7A-3B4A-4F7C-9E4D-1A2B3C4D5E6F" />
                </Activation>

                <Definitions>
                  <!-- System Health Widget -->
                  <Definition Id="SystemHealth"
                             DisplayName="System Health"
                             Description="Live CPU, RAM, Disk and Battery stats">
                    <Capabilities>
                      <Capability>
                        <Size Name="small" />
                      </Capability>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\SystemHealth_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\SystemHealth_Screenshot.png" />
                      </Screenshots>
                    </ThemeResources>
                  </Definition>

                  <!-- GitHub Activity Widget -->
                  <Definition Id="GitHubActivity"
                             DisplayName="GitHub Activity"
                             Description="Your commits, PRs and code review status">
                    <Capabilities>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\GitHub_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\GitHub_Screenshot.png" />
                      </Screenshots>
                    </ThemeResources>
                  </Definition>

                  <!-- Hacker News Widget -->
                  <Definition Id="HackerNews"
                             DisplayName="Hacker News"
                             Description="Top tech news from Hacker News">
                    <Capabilities>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\News_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\News_Screenshot.png" />
                      </Screenshots>
                    </ThemeResources>
                  </Definition>

                  <!-- Standup Prep Widget -->
                  <Definition Id="Standup"
                             DisplayName="Standup Prep"
                             Description="Yesterday's work summary for daily standup">
                    <Capabilities>
                      <Capability>
                        <Size Name="medium" />
                      </Capability>
                      <Capability>
                        <Size Name="large" />
                      </Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\Standup_Icon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\Standup_Screenshot.png" />
                      </Screenshots>
                    </ThemeResources>
                  </Definition>

                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
