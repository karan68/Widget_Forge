{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.6",
    "body": [
        {
            "type": "TextBlock",
            "text": "Hacker News",
            "size": "Large",
            "weight": "Bolder",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "${story1}",
            "wrap": true,
            "size": "Small"
        },
        {
            "type": "TextBlock",
            "text": "${story2}",
            "wrap": true,
            "size": "Small"
        },
        {
            "type": "TextBlock",
            "text": "${story3}",
            "wrap": true,
            "size": "Small"
        }
    ],
    "actions": [
        {"type": "Action.Execute", "title": "Refresh", "verb": "refresh"}
    ]
}
