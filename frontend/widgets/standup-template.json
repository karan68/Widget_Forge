{
    "type": "AdaptiveCard",
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.6",
    "body": [
        {
            "type": "TextBlock",
            "text": "Standup Prep",
            "size": "Large",
            "weight": "Bolder",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "Yesterday:",
            "weight": "Bolder",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "${yesterday_summary}",
            "wrap": true,
            "size": "Small"
        },
        {
            "type": "ColumnSet",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {"type": "TextBlock", "text": "${open_prs} open PRs", "size": "Small", "wrap": true}
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "items": [
                        {"type": "TextBlock", "text": "${reviews} reviews", "size": "Small", "wrap": true}
                    ]
                }
            ]
        }
    ],
    "actions": [
        {"type": "Action.Execute", "title": "Refresh", "verb": "refresh"}
    ]
}
