{
    "name": "Widget Forge",
    "short_name": "WidgetForge",
    "description": "AI-powered custom Windows 11 Widgets - ask in natural language, get live widgets on your desktop",
    "start_url": "/",
    "display": "standalone",
    "background_color": "#1a1a2e",
    "theme_color": "#667eea",
    "icons": [
        {
            "src": "icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "widgets": [
