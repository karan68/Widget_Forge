# ─── LLM Configuration ───────────────────────────────
# Provider priority (auto = groq → gemini → ollama)
LLM_PROVIDER=auto

# Groq - Fast cloud inference (PRIMARY)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Google Gemini - Reliable fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Ollama - Local LLM (last resort, slow but offline)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=mistral

# Google (for Google Calendar/Gmail)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/callback/google

# Azure DevOps
ADO_ORG=your_ado_org
ADO_PROJECT=your_ado_project
ADO_PAT=your_ado_pat_here

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username

# RapidAPI (Cricket)
RAPIDAPI_KEY=your_rapidapi_key_here

# WeatherAPI.com
WEATHERAPI_KEY=your_weatherapi_key_here

# NewsData.io
NEWSDATA_KEY=your_newsdata_key_here

# Serpstack (Google Search)
SERPSTACK_KEY=your_serpstack_key_here
